// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "kubernetes": {
      "enabled": false,
      "remote": false,
      "settings": {},
    },
  },
  "format_on_save": "on",
  "status_bar": {
    "line_endings_button": true,
  },
  "title_bar": {
    "show_project_items": true,
    "show_onboarding_banner": false,
  },
  "auto_install_extensions": {
    "html": true,
    "dockerfile": true,
    "docker-compose": false,
    "just": true,
    "git-firefly": true,
    "toml": true,
    "vscode-dark-modern": true,
    "helm": true,
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml",
    ],
  },
  "lsp": {
    "ty": {
      "settings": {
        "diagnosticMode": "off",
      },
    },
  },
  "semantic_tokens": "combined",
  "collaboration_panel": {
    "default_width": 300.0,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "default_width": 300.0,
    "dock": "left",
  },
  "cli_default_open_behavior": "new_window",
  "bottom_dock_layout": "full",
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed",
  },
  "inline_code_actions": false,
  "project_panel": {
    "dock": "left",
    "indent_size": 14.0,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "colorize_brackets": true,
  "auto_update": false,
  "toolbar": {
    "quick_actions": false,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo",
        "model": "gemini-3.8-flash-medium",
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-luna",
        "mode": "agent",
        "collaboration_mode": "default",
        "reasoning_effort": "max",
      },
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "buffer_font_size": 13.0,
  "buffer_font_family": "JetBrains Mono",
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff"],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "YAML": {
      "formatter": "language_server",
    },
  },
  "agent": {
    "threads_sidebar": {
      "position": "right",
    },
    "play_sound_when_agent_done": "when_hidden",
    "auto_compact": {
      "threshold": "90%",
    },
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-luna",
      "enable_thinking": false,
    },
    "flexible": true,
    "enable_feedback": false,
    "max_content_width": 1000.0,
    "limit_content_width": true,
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "bottom", //
    "show_turn_stats": true,
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "openai",
      "model": "gpt-5.6-luna",
    },
    "favorite_models": [],
    "default_profile": "write",
    "model_parameters": [],
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "gutter": {
    "min_line_number_digits": 0,
  },
  "minimap": {
    "thumb": "hover",
    "max_width_columns": 60,
    "show": "auto",
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "shell": {
      "program": "fish",
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "theme": "VSCode Dark Modern",
}
