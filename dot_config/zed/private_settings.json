// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_install_extensions": {
    "html": true,
    "dockerfile": true,
    "docker-compose": false,
    "just": true,
    "git-firefly": true,
    "toml": true,
    "vscode-dark-modern": true,
    "helm": true,
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml",
    ],
  },
  "semantic_tokens": "combined",
  "collaboration_panel": {
    "default_width": 300.0,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "default_width": 300.0,
    "dock": "left",
  },
  "cli_default_open_behavior": "new_window",
  // "bottom_dock_layout": "full",
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed",
  },
  "inline_code_actions": false,
  "project_panel": {
    "dock": "left",
    "indent_size": 14.0,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "colorize_brackets": true,
  "auto_update": false,
  "toolbar": {
    "quick_actions": false,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "qwen-code": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "buffer_font_size": 13.0,
  "buffer_font_family": "JetBrains Mono",
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff"],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "YAML": {
      "formatter": "language_server",
    },
  },
  "agent": {
    "thinking_display": "always_collapsed",
    "enable_feedback": false,
    "sidebar_side": "right",
    "max_content_width": 1000.0,
    "limit_content_width": true,
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "right",
    "show_turn_stats": true,
    "default_model": {
      "enable_thinking": false,
      "provider": "zed.dev",
      "model": "claude-haiku-4-5",
    },
    "favorite_models": [],
    "default_profile": "ask",
    "model_parameters": [],
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "gutter": {
    "min_line_number_digits": 0,
  },
  "minimap": {
    "thumb": "hover",
    "max_width_columns": 60,
    "show": "auto",
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "shell": {
      "program": "fish",
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "theme": "VSCode Dark Modern",
}
